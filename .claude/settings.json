{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hook": "bash scripts/hook-check-lock.sh \"$TOOL_INPUT\""
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hook": "bash scripts/hook-post-bash.sh \"$TOOL_INPUT\""
      }
    ]
  }
}
